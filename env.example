PORT=5000
GEMINI_API_KEY=여기에_발급받은_Gemini_API_키를_입력하세요

# Supabase 대시보드 -> Project Settings -> API 에서 확인
# (2026-09 이후: 새 API Keys 화면의 "Secret keys" 섹션에서 sb_secret_... 값을 사용하세요)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=여기에_Supabase_secret_key(sb_secret_...)를_입력하세요

# 포트원(PortOne) 대시보드 -> 결제 연동 -> API Secret
PORTONE_API_SECRET=여기에_발급받은_PortOne_API_Secret을_입력하세요

# 결제 웹훅 검증용 (포트원 대시보드 -> 웹훅 설정에서 발급)
PORTONE_WEBHOOK_SECRET=여기에_발급받은_PortOne_Webhook_Secret을_입력하세요

# 선택 사항: Semantic Scholar API 키 (없어도 논문 검색은 동작하지만, 있으면 더 넉넉한 속도 제한을 받습니다)
# 무료 발급: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ⚠️ 주의: 이 파일(env.example)은 "예시/템플릿"입니다. 실제 값을 여기에 채워서 저장하지 마세요.
# 실제 값은 .env 파일(로컬 전용, .gitignore에 포함되어야 함) 또는 Render 등 배포 환경의
# "Environment Variables" 설정 화면에만 입력하세요. GitHub에는 절대 올리지 마세요.
